# Copy to .env (never commit .env).

# Where the Vite dev server forwards API calls (/orders, /boxes, /health).
# Default: the backend on this same machine.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional. Call the API directly instead of through the proxy (the backend's CORS must allow it).
# Leave empty for the recommended same-origin setup.
VITE_API_BASE_URL=

# Optional. Pre-fills the "staff RFID UID" box on the simulator page for simulated taps.
# Never shown on the public box screen.
VITE_DEMO_STAFF_UID=STAFF-TAG-01
