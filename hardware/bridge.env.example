# Settings for bridge.py on the Raspberry Pi. Copy to bridge.env and edit (never commit bridge.env).

BOX_ID=BOX-01

# API_BASE_URL is the backend. PUBLIC_URL is what phones open (QR/NFC).
# Prefer the public hostname; for a branch demo use .../<branch> (no trailing slash).
API_BASE_URL=https://novabox.recursivefunctions.dev
PUBLIC_URL=https://novabox.recursivefunctions.dev

# Screen: fb = draw on the 3.5" LCD (/dev/fb1), png = preview files, none = no screen.
DISPLAY_MODE=fb
FB_DEVICE=/dev/fb1
# 0 = auto (portrait framebuffers are turned to landscape). Use 180 if the image is upside down.
ROTATE=0

# Lock: motor = DC motor through the H-bridge, none = screen only.
LOCK_MODE=motor
# BCM pin numbers (not physical pin numbers). Defaults: GPIO5 = pin 29, GPIO6 = pin 31. Speed is PWM on these.
MOTOR_IN1=5
MOTOR_IN2=6
# Pin wired to the driver's enable input (held high). -1 = keep the L298N ENA jumper on / driver has none.
MOTOR_ENABLE=-1
# How long and how hard the motor turns per lock/unlock. Tune on the real latch.
LOCK_SECONDS=0.6
LOCK_SPEED=0.6
# Optional limit switches (switch between the GPIO pin and GND). Leave empty if not fitted.
LOCKED_SWITCH=
UNLOCKED_SWITCH=
