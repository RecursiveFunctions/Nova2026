# Copy to .env (never commit .env). No inline comments after values.

# Header X-Demo-Key required by /demo/* endpoints. If left blank, /demo/* only accepts
# requests from the machine running the API.
DEMO_API_KEY=change-me

# Pickup code lifetime after the order becomes READY. Raise it for rehearsals.
PICKUP_CODE_TTL_MINUTES=15

# After a wrong code, retries on that order get HTTP 429 for this long. Never a lockout.
FAILED_ATTEMPT_COOLDOWN_SECONDS=1

BOX_IDS=BOX-01,BOX-02

# Registered staff RFID cards, comma separated. Case, ':' and '-' are ignored when matching.
# Add the real card here once the reader shows its UID (or use POST /demo/staff).
STAFF_RFID_UIDS=STAFF-TAG-01

# Allowed browser origins for the React apps ("*" is fine for a LAN demo).
CORS_ORIGINS=*

# Public origin encoded into QR / NFC pickup links. Branch demos also set PUBLIC_PATH_PREFIX=/<slug>.
PUBLIC_BASE_URL=https://novabox.recursivefunctions.dev
PUBLIC_PATH_PREFIX=

# Optional. Key used to derive/hash pickup codes. If blank, one is generated into
# data/.pickup_secret on first start.
PICKUP_CODE_SECRET=

# Defaults to backend/data/pickup_box.db. If this folder is inside OneDrive (or Dropbox etc.),
# point it somewhere that is not synced, e.g. C:/pickupbox/pickup_box.db
# DATABASE_PATH=
